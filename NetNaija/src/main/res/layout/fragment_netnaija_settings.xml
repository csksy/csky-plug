<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETNAIJA"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#E50914"
        android:letterSpacing="0.22" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#F5F5F6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="Server and playback options"
        android:textSize="12.5sp"
        android:textColor="#8E8E96" />

    <LinearLayout
        android:id="@+id/hostRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/settings_item_background"
        android:focusable="true"
        android:clickable="true">

        <FrameLayout
            android:id="@+id/host_container"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/ic_icon_bg_red">

            <ImageView
                android:id="@+id/hostIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/settings_icon"
                android:contentDescription="API host" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Host"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#F2F2F4" />

            <TextView
                android:id="@+id/hostSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#8E8E96" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron_host"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron"
            android:contentDescription="Select host" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/saveContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/outline"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/saveIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/save_icon"
            android:contentDescription="Save" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Save &amp; Reload"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F2F2F4" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Changes are applied after the app restarts"
        android:textSize="10.5sp"
        android:textColor="#5C5C64" />
</LinearLayout>
