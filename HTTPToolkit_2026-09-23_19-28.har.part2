isodeString\":\"931\"}},\"lastEpisodeDate\":{\"dub\":{\"hour\":2,\"minute\":21,\"year\":2026,\"month\":4,\"date\":4},\"sub\":{\"hour\":16,\"minute\":18,\"year\":2026,\"month\":8,\"date\":20,\"second\":26},\"raw\":{}},\"type\":\"TV\",\"season\":{\"quarter\":\"Fall\",\"year\":1999},\"score\":8.73,\"airedStart\":{\"year\":1999,\"month\":9,\"date\":20,\"hour\":14,\"minute\":15},\"availableEpisodes\":{\"sub\":1180,\"dub\":1161,\"raw\":0},\"episodeDuration\":\"1440000\",\"episodeCount\":null,\"lastUpdateEnd\":\"2026-09-22T02:01:01.018Z\",\"characterCount\":\"819\",\"playlistCount\":\"1098\",\"tierListCount\":\"13\",\"worldMapCount\":null,\"caseFileCount\":\"2\",\"isAdult\":false,\"adultAssetsHidden\":null,\"siteRanks\":{\"entries\":[{\"key\":\"weekly\",\"label\":\"Trending\",\"position\":1,\"delta\":0,\"sortOrder\":10,\"score\":71368,\"windowDays\":7},{\"key\":\"monthly\",\"label\":\"Most viewed\",\"position\":1,\"delta\":0,\"sortOrder\":20,\"score\":274103,\"windowDays\":30},{\"key\":\"overall\",\"label\":\"All time\",\"position\":1,\"delta\":0,\"sortOrder\":25,\"score\":14130247,\"windowDays\":null},{\"key\":\"bookmarked\",\"label\":\"Most saved\",\"position\":9,\"delta\":0,\"sortOrder\":30,\"score\":526,\"windowDays\":30},{\"key\":\"bookmarkedOverall\",\"label\":\"All-time saved\",\"position\":1,\"delta\":0,\"sortOrder\":35,\"score\":18049,\"windowDays\":null},{\"key\":\"boostedMonthly\",\"label\":\"Most boosted\",\"position\":109,\"delta\":7,\"sortOrder\":40,\"score\":86,\"windowDays\":30},{\"key\":\"boosted\",\"label\":\"Power ranking\",\"position\":7,\"delta\":1,\"sortOrder\":45,\"score\":2250,\"windowDays\":null}],\"weekly\":{\"score\":71368,\"windowDays\":7},\"monthly\":{\"score\":274103,\"windowDays\":30},\"overall\":{\"score\":14130247,\"windowDays\":null},\"bookmarked\":{\"score\":526,\"windowDays\":30},\"bookmarkedOverall\":{\"score\":18049,\"windowDays\":null},\"boostedMonthly\":{\"score\":86,\"windowDays\":30},\"boosted\":{\"score\":2250,\"windowDays\":null}},\"description\":\"Gold Roger was known as the Pirate King, the strongest and most infamous being to have sailed the Grand Line. The capture and death of Roger by the World Government brought a change throughout the world. His last words before his death revealed the location of the greatest treasure in the world, One Piece. It was this revelation that brought about the Grand Age of Pirates, men who dreamed of finding One Piece (which promises an unlimited amount of riches and fame), and quite possibly the most coveted of titles for the person who found it, the title of the Pirate King.<br><br>\\nEnter Monkey D. Luffy, a 17-year-old boy that defies your standard definition of a pirate. Rather than the popular persona of a wicked, hardened, toothless pirate who ransacks villages for fun, Luffy’s reason for being a pirate is one of pure wonder; the thought of an exciting adventure and meeting new and intriguing people, along with finding One Piece, are his reasons of becoming a pirate. Following in the footsteps of his childhood hero, Luffy and his crew travel across the Grand Line, experiencing crazy adventures, unveiling dark mysteries and battling strong enemies, all in order to reach One Piece.<br><br>\\n<b>*This includes the following special episodes:</b><br>\\n- Chopperman to the Rescue! Protect the TV Station by the Shore! (Episode 336)<br>\\n- The Strongest Tag-Team! Luffy and Toriko's Hard Struggle! (Episode 492)<br>\\n- Team Formation! Save Chopper (Episode 542)<br>\\n- History's Strongest Collaboration vs. Glutton of the Sea (Episode 590)<br>\\n- 20th Anniversary! Special Romance Dawn (Episode 907)\",\"thumbnails\":[\"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21-ELSYx3yMPcKM.jpg\"],\"tbVars\":[{\"u\":\"mcovers/a_tbs/ReooPAxPMsHM4KPMY/001.webp\",\"sm\":90,\"md\":null,\"ts\":1784552706549}],\"genres\":[\"Action\",\"Adventure\",\"Comedy\",\"Super Power\",\"Drama\",\"Fantasy\",\"Shounen\",\"Samurai\",\"Isekai\"],\"status\":\"Releasing\",