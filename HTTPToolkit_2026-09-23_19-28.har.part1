table: false,\n            configurable: false,\n            enumerable: false\n          });\n        } catch (e) {}\n      })();\n    </script>\n    <script>\n      (function () {\n        try {\n          var ua = navigator.userAgent || '';\n          var tv = /\\bAFT[A-Z0-9]+\\b/i.test(ua) || /AmazonWebAppPlatform|GoogleTV|CrKey\\b|Android TV|BRAVIA|Tizen|Web0S|HbbTV|SmartTV/i.test(ua);\n          var nestedOverflowBreaks = false;\n          try {\n            nestedOverflowBreaks = window.matchMedia('(max-width: 1023px), (pointer: coarse)').matches;\n          } catch (e3) {}\n          if (tv || nestedOverflowBreaks) {\n            document.documentElement.setAttribute('data-scroll-root', 'document');\n          }\n          var vv = window.visualViewport;\n          var vh = Math.round((vv && vv.height) || window.innerHeight || 0);\n          var vt = Math.round((vv && vv.offsetTop) || 0);\n          if (vh > 0) {\n            document.documentElement.style.setProperty('--app-vvh', vh + 'px');\n            document.documentElement.style.setProperty('--app-vv-top', vt + 'px');\n          }\n        } catch (e) {}\n      })();\n    </script>\n    <script>\n      (function () {\n        try {\n          //STORAGE_PREFIX\n          var raw = localStorage.getItem(STORAGE_PREFIX + 'themeMode');\n          var mode = 'auto';\n          if (raw) {\n            try {\n              mode = JSON.parse(raw);\n            } catch (e) {\n              mode = raw;\n            }\n          }\n          if (mode !== 'light' && mode !== 'night' && mode !== 'auto') {\n            mode = 'auto';\n          }\n          var resolved = mode;\n          if (mode === 'auto') {\n            resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'light';\n          } else {\n            resolved = mode === 'night' ? 'night' : 'light';\n          }\n          document.documentElement.setAttribute('data-theme', resolved);\n          if (resolved === 'night') {\n            document.documentElement.setAttribute('data-theme-boot', 'pending');\n          }\n          var themeColor = resolved === 'night' ? '#000000' : '#ffffff';\n          var themeMeta = document.querySelector('meta[name=\"theme-color\"]');\n          if (!themeMeta) {\n            themeMeta = document.createElement('meta');\n            themeMeta.setAttribute('name', 'theme-color');\n            document.head.appendChild(themeMeta);\n          }\n          themeMeta.setAttribute('content', themeColor);\n        } catch (e) {\n          document.documentElement.setAttribute('data-theme', 'light');\n          var fallbackMeta = document.querySelector('meta[name=\"theme-color\"]');\n          if (!fallbackMeta) {\n            fallbackMeta = document.createElement('meta');\n            fallbackMeta.setAttribute('name', 'theme-color');\n            document.head.appendChild(fallbackMeta);\n          }\n          fallbackMeta.setAttribute('content', '#ffffff');\n        }\n      })();\n    </script>\n    <!-- Critical paint: bundled CSS vars load later; without this, first paint is browser-white on dark theme. -->\n    <style id=\"theme-critical\">\n      html {\n        color-scheme: light;\n      }\n      html[data-theme='light'],\n      html:not([data-theme]) {\n        color-scheme: light;\n        background-color: #ffffff;\n      }\n      html[data-theme='night'] {\n        color-scheme: dark;\n        background-color: #000000;\n      }\n      html[data-theme='light'] body,\n      html:not([data-theme]) body {\n        background-color: #ffffff;\n        color: #0f172a;\n      }\n      html[data-theme='night'] body {\n        background-color: #000000;\n        color: #dddddd;\n      }\n      html[data-theme='night'][data-theme-boot='pending'] body {\n        opacity: 0;\n      }\n      @media (prefers-reduced-motion: no-preference) {\n        html[data-theme='night'].theme-boot-reveal body {\n          animation: theme-boot-in 0.35s ease forwards;\n    