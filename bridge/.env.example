# Get these from https://my.telegram.org (api_id and api_hash) - free, 2 minutes.
API_ID=12345678
API_HASH=your_api_hash_here

# Optional: a persistent Telethon session string (survives server restarts).
# Generate one on your PC:
#   pip install telethon
#   python -c "import asyncio,os; from telethon import TelegramClient; from telethon.sessions import StringSession; \
#   async def m(): c=TelegramClient(StringSession(), int(os.environ['API_ID']), os.environ['API_HASH']); \
#   await c.start(); print(c.session.save()); await c.disconnect()"
#   asyncio.run(m())
# Then set TG_SESSION_STRING to the printed value.
TG_SESSION_STRING=

# Optional: protect the bridge with a token. The plugin would need to send it.
BRIDGE_TOKEN=

# Optional overrides
# GROUP_USERNAME=eera_Search_Zone
# BOT_USERNAME=Movie_world2_bot
# PORT=8000
