<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: this layout must never reference @drawable / @color / @string
     resources inline. CloudStream inflates plugin layouts with the host
     app's LayoutInflater, so inline resource ids resolve against the APP's
     resource table and collide (crash: "Error inflating class"). Every
     drawable is applied programmatically from the plugin resources in
     NetNaijaAppSettingsFragment. Inline hex colors and framework
     attributes are safe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETNAIJA APP"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FF2E3B"
        android:letterSpacing="0.24" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FAFAFB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Server and playback options"
        android:textSize="12.5sp"
        android:textColor="#8F8F98" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="6dp"
        android:text="SERVER &amp; API"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:textColor="#6E6E78"
        android:letterSpacing="0.14" />

    <LinearLayout
        android:id="@+id/hostRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:focusable="true"
        android:clickable="true">

        <FrameLayout
            android:id="@+id/host_container"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/hostIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="API host" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Host"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#F4F4F6" />

            <TextView
                android:id="@+id/hostSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#8F8F98" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron_host"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:contentDescription="Select host" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/saveContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/saveIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Save" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Save &amp; Reload"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Changes are applied after the app restarts"
        android:textSize="10.5sp"
        android:textColor="#5C5C66" />
</LinearLayout>
