\",\"wallet.migrationMessage\":\"Update your embed and direct links to the Byse domain to enable payouts. Until then, payments are held back for security reasons.\",\"wallet.source.manual\":\"Manual\",\"wallet.source.autoCron\":\"Auto cron\",\"wallet.warning.disabled\":\"Automatic payouts are currently disabled.\",\"wallet.warning.configureMethod\":\"Set a payout method and payout address in Settings to enable automatic payouts.\",\"wallet.warning.threshold\":\"Automatic payouts start once your balance reaches {{amount}}.\",\"wallet.warning.insufficientViews\":\"Your account needs at least {{required}} views in the last 30 days to qualify for payouts. You currently have {{current}}.\",\"wallet.warning.insufficientUploads\":\"Your account needs at least {{required}} uploads in each of the last {{months}} months to qualify for payouts.\",\"wallet.warning.readyForRun\":\"You're ready for the next automatic payout. Once created, it will be scheduled on a Net+{{netDays}} basis.\",\"wallet.success.processingWithDate\":\"Your payout is being processed. The current scheduled send date is {{scheduledDate}}.\",\"wallet.success.processing\":\"Your payout is being processed. We'll notify you when it's done.\",\"wallet.success.queuedWithDate\":\"Your automatic payout is queued and scheduled to be sent on {{scheduledDate}}.\",\"wallet.success.queued\":\"Your automatic payout is queued and waiting to be processed.\",\"premiumDashboard.loadError\":\"Failed to load premium data\",\"premiumDashboard.title\":\"Premium\",\"premiumDashboard.status.accountBandwidth\":\"Account + bandwidth active\",\"premiumDashboard.status.account\":\"Premium account active\",\"premiumDashboard.status.bandwidth\":\"Premium bandwidth active\",\"premiumDashboard.status.none\":\"No premium plan\",\"premiumDashboard.toggle.disableEncoding.label\":\"Disable encoding\",\"premiumDashboard.toggle.disableEncoding.description\":\"Keep the original file without re-encoding.\",\"premiumDashboard.toggle.multiQuality.label\":\"Encode multiple qualities\",\"premiumDashboard.toggle.multiQuality.description\":\"Automatically create 1080p, 720p and 480p versions of every video.\",\"premiumDashboard.toggle.removeAds.label\":\"Remove player ads\",\"premiumDashboard.toggle.removeAds.description\":\"Show an ad-free player during premium playback.\",\"premiumDashboard.toggle.directApi.label\":\"Enable direct API links\",\"premiumDashboard.toggle.directApi.description\":\"Allow direct playback URLs generated through the API for premium streams.\",\"premiumDashboard.subtitle\":\"Manage your premium account and bandwidth in one place.\",\"premiumDashboard.description\":\"Adjust encoding preferences, monitor premium bandwidth, and review recent invoices.\",\"premiumDashboard.loadingData\":\"Loading premium data…\",\"premiumDashboard.upgradeAria\":\"Premium upgrade\",\"premiumDashboard.browsePlans\":\"Browse premium plans\",\"premiumDashboard.summaryAria\":\"Premium summary\",\"premiumDashboard.premiumAccount\":\"Premium account\",\"premiumDashboard.expirationDate\":\"Expiration date\",\"premiumDashboard.premiumBandwidth\":\"Premium bandwidth\",\"premiumDashboard.tbRemaining\":\"{{value}} TB remaining\",\"premiumDashboard.controlsAria\":\"Premium controls\",\"premiumDashboard.saving\":\"Saving…\",\"premiumDashboard.saveChanges\":\"Save changes\",\"premiumDashboard.noControls\":\"Your current premium plan does not include configurable controls.\",\"premiumDashboard.bandwidthHistoryAria\":\"Premium bandwidth history\",\"premiumDashboard.bandwidthHistoryTitle\":\"Premium bandwidth history (30 days)\",\"premiumDashboard.bandwidthHistoryEmpty\":\"Bandwidth usage history will appear once traffic is recorded.\",\"premiumDashboard.bandwidthTrendAria\":\"Premium bandwidth trend\",\"premiumDashboard.topReferersAria\":\"Top premium referers\",\"premiumDashboard.topReferersTitle\":\"Top premium referers (24h)\",\"premiumDashboard.topReferersEmpty\":\"No premium traffic recorded in the last 24 hours.\",\"premiumDashboard.direct\":\"Direct\",\"premiumDashboard.refererShare\":\"{{share}}% of premium traffic\",\"premiumDashboard.viewsCount\":\"{{count}} views\",\"premiumDashboard.recentInvoicesAria\":\"Recent premium invoices\",\"premiumDashboard.recentInvoicesTitle\":\"Recent premium invoices\",\"premiumDashboard.recentInvoicesEmpty\":\"Invoices will appear here after a successful payment.\",\"premiumDashboard.invoiceValue\":\" • Value {{value}}\",\"premiumDashboard.upgradeMessage\":\"Upgrade to premium to access advanced controls.\",\"premiumDashboard.active\":\"Active\",\"premiumDashboard.loadErrorTitle\":\"Couldn't load premium data\",\"premiumDashboard.upgradeTitle\":\"Upgrade to premium\",\"premiumDashboard.manageControlsTitle\":\"Manage premium controls\",\"premiumPlan.eyebrow\":\"Build your plan\",\"premiumPlan.badge\":\"Premium\",\"premiumPlan.heroTitle\":\"Premium built for serious creators\",\"premiumPlan.bandwidthCaption\":\"Delivery bandwidth for your viewers.\",\"premiumPlan.storageCaption\":\"Your maximum disk space for files.\",\"premiumPlan.youGetTitle\":\"What you get\",\"premiumPlan.perTbPrice\":\"${{price}} / TB\",\"premiumPlan.youGetStorageDesc\":\"your maximum disk space\",\"premiumPlan.youGetBandwidthDesc\":\"premium bandwidth — carries over\",\"premiumPlan.statBandwidth\":\"Premium bandwidth\",\"premiumPlan.statStorage\":\"Monthly storage\",\"premiumPlan.statMax\":\"Max bandwidth per order\",\"premiumPlan.featuresTitle\":\"Everything you get\",\"premiumPlan.featNoAdsDesc\":\"Premium playback without any player ads.\",\"premiumPlan.featManagerDesc\":\"Real-time controls to shape how bandwidth is spent.\",\"premiumPlan.featReportsDesc\":\"See exactly where your traffic goes, by referer and country.\",\"premiumPlan.featStorageDesc\":\"Your files are mirrored across multiple storage nodes.\",\"premiumPlan.featInstantDesc\":\"Resources are added the moment your payment confirms.\",\"premiumPlan.featApiDesc\":\"Generate direct playback links for premium streams.\",\"premiumPlan.faqTitle\":\"Frequently asked questions\",\"premiumPlan.faqQ1\":\"Is the storage I buy my usable disk space?\",\"premiumPlan.faqA1\":\"Yes. The storage you buy becomes your maximum disk space — exactly the amount you can use for your files and uploads. It renews every month.\",\"premiumPlan.faqQ2\":\"Does premium bandwidth expire?\",\"premiumPlan.faqA2\":\"No. Premium bandwidth carries over between months and is only used as your viewers stream — until it runs out.\",\"premiumPlan.faqQ3\":\"How am I billed?\",\"premiumPlan.faqA3\":\"Each purchase creates an invoice you pay with crypto. Two weeks before your storage expires we email a renewal invoice.\",\"premiumPlan.faqQ4\":\"Can I buy bandwidth and storage separately?\",\"premiumPlan.faqA4\":\"No. Premium bandwidth and storage come as one combined plan — you choose how much of each, and pay for both together.\",\"premiumPlan.heroSubtitle\":\"Faster delivery, an ad-free player, and storage that scales. Pick a premium account, premium bandwidth, or both.\",\"premiumPlan.heroCtaBuild\":\"Build a plan\",\"premiumPlan.heroCtaPlans\":\"Premium accounts\",\"premiumPlan.accountTitle\":\"Premium account\",\"premiumPlan.accountSubtitle\":\"Keep your original files, encode multiple qualities, and get priority uploads and faster processing.\",\"premiumPlan.pitchTitle\":\"Bandwidth and storage, billed your way\",\"premiumPlan.pitchBody\":\"Premium bandwidth removes player ads and unlocks delivery controls; storage keeps your master files online. Move the sliders, pay with crypto, done.\",\"premiumPlan.includedTitle\":\"What's included\",\"premiumPlan.featNoAds\":\"Ad-free player\",\"premiumPlan.featManager\":\"Bandwidth manager\",\"premiumPlan.featReports\":\"Detailed delivery reports\",\"premiumPlan.featStorage\":\"Redundant storage nodes\",\"premiumPlan.featInstant\":\"Instant activation\",\"premiumPlan.featApi\":\"Direct delivery links\",\"premiumPlan.howTitle\":\"How it works\",\"premiumPlan.step1\":\"Pick your bandwidth and storage with the sliders.\",\"premiumPlan.step2\":\"Pay securely with crypto — we generate your invoice automatically.\",\"premiumPlan.step3\":\"Your plan activates instantly. We email a renewal invoice two weeks before storage expires.\",\"premiumPlan.notesTitle\":\"Good to know\",\"premiumPlan.note1\":\"Premium bandwidth never expires — it carries over until you use it up.\",\"premiumPlan.note2\":\"Storage is a monthly allowance and renews each month.\",\"premiumPlan.note3\":\"Every payment produces an invoice you can open or print from your dashboard.\",\"premiumPlan.title\":\"Premium bandwidth & storage\",\"premiumPlan.packageNote\":\"One combined plan — pick how much of each.\",\"premiumPlan.description\":\"Choose how much premium bandwidth and storage you need. Billed monthly — bandwidth carries over until you use it up, storage renews each month.\",\"premiumPlan.bandwidth\":\"Premium bandwidth\",\"premiumPlan.storage\":\"Storage\",\"premiumPlan.bandwidthHint\":\"${{price}} per TB · carries over\",\"premiumPlan.storageHint\":\"${{price}} per TB · renews monthly\",\"premiumPlan.monthlyTotal\":\"Monthly total\",\"premiumPlan.month\":\"month\",\"premiumPlan.checkout\":\"Pay with crypto\",\"premiumPlan.signIn\":\"Sign in to continue\",\"premiumPlan.processing\":\"Opening checkout…\",\"premiumPlan.unavailable\":\"Crypto payments are unavailable right now. Please try again later.\",\"premiumPlan.maxNote\":\"Up to {{max}} TB of bandwidth per purchase.\",\"premiumPlan.planTitle\":\"Bandwidth & storage\",\"premiumPlan.buyMore\":\"Buy more\",\"premiumPlan.balanceTitle\":\"Premium bandwidth\",\"premiumPlan.carriesOver\":\"carries over\",\"premiumPlan.storageTitle\":\"Storage allowance\",\"premiumPlan.storageRenews\":\"Renews {{date}}\",\"premiumPlan.storageInactive\":\"No active storage allowance\",\"premiumPlan.invoicesTitle\":\"Invoices\",\"premiumPlan.invoicesSubtitle\":\"View and pay your premium invoices.\",\"premiumPlan.invoicesEmpty\"