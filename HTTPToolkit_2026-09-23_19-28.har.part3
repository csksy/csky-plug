wser preferences.\",\"legal.lastUpdated\":\"Last updated: {{date}}\",\"legal.questions\":\"Questions?\",\"legal.onThisPage\":\"On this page\",\"player.videoSourceUnavailable\":\"Video source is unavailable.\",\"player.forwardTenSeconds\":\"Forward 10 sec\",\"player.unableToLoadScript\":\"Unable to load the JW Player script.\",\"player.resume.heading\":\"Resume watching?\",\"player.resume.body\":\"You left off at {{time}}.\",\"player.resume.resumeButton\":\"Resume\",\"player.resume.restartButton\":\"Start over\",\"player.resume.dismissLabel\":\"Dismiss\",\"player.diagnostics.kicker\":\"Connection diagnostics\",\"player.diagnostics.promptHeading\":\"We noticed buffering\",\"player.diagnostics.promptBody\":\"Run a quick connection test so we can adjust playback quality for you.\",\"player.diagnostics.runButton\":\"Run diagnostics\",\"player.diagnostics.dismissButton\":\"Not now\",\"player.diagnostics.measuringDownload\":\"Measuring download speed…\",\"player.diagnostics.sending\":\"Sending results to our technical team…\",\"player.diagnostics.subDownload\":\"Download\",\"player.diagnostics.metric.download\":\"Download\",\"player.diagnostics.metric.latency\":\"Latency\",\"player.diagnostics.metric.jitter\":\"Jitter\",\"player.diagnostics.metric.server\":\"Server\",\"player.diagnostics.unit.mbps\":\"Mbps\",\"player.diagnostics.unit.ms\":\"ms\",\"player.diagnostics.sentHeading\":\"Diagnostics sent\",\"player.diagnostics.sentBody\":\"Your diagnostic data was sent to our team. Thanks for helping us improve playback.\",\"player.diagnostics.continueButton\":\"Continue watching\",\"player.diagnostics.errorHeading\":\"Test unavailable\",\"player.diagnostics.errorBody\":\"We couldn't complete the connection test, but you can keep watching.\",\"player.diagnostics.dismissLabel\":\"Dismiss\",\"player.error.kicker\":\"Playback issue\",\"player.error.technicalCode\":\"Error {{code}}\",\"player.error.reportButton\":\"Report issue\",\"player.error.reloadButton\":\"Reload\",\"player.err