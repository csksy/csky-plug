,\n            headers: {\n                'x-token': window.location.hostname,\n            },\n            body: formData\n        }),\n            data = \"\";\n        try {\n            data = await response.json()\n        } catch (error) { }\n        return data\n    }\n    \n    async function tasktype(action, getelement, task, final)\n    {\n        setan(getelement, true);\n        thiselement = document.getElementById(getelement);\n        console.log(thiselement);\n        thiselement.disabled = true;\n        thiselement.innerHTML = \"\";\n        var span = document.createElement(\"span\"),\n            text = document.createTextNode(task);\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            thiselement.appendChild(span);\n            thiselement.appendChild(text);\n            taskaction(action).then(data => {\n            setan(getelement, true);\n                if (data.visit_url) {\n                    thiselement.innerHTML = final;\n                    window.location.href = data.visit_url;\n                } else if (data.url) {\n                    thiselement.innerHTML = final;\n                    window.location.href = data.url;\n                } else {\n                    setan(getelement);\n                    thiselement.innerHTML = final;\n                    if (data.error) {\n                        toastr(\"alert\", data.message)\n                    } else {\n                        toastr(\"alert\", \"Oops, error.\")\n                    }\n                }\n        });\n    }\n    \n    if (document.getElementById(\"ins\") !== null) {\n        document.getElementById(\"ins\").onclick = function () {\n            tasktype(\"instant\", \"ins\", \"Generating...\", \"File Generated\")\n        };\n    }\n\n</script>\n\n\n<br>\n\n<center>\n    <div id=\"pages\" style=\"width:90%;\"> <center>\n    <div class=\"card\" style=\"width:90%;\">\n        <div class=\"card-header\" style=\"border:0px;