c8187ffb701db8c507593d9e4d492\");\n        formData.append(\"action_token\", cf_token);\n        var response = await fetch(window.location.pathname, {\n            method: \"POST\",\n            headers: {\n                'x-token': window.location.hostname,\n            },\n            body: formData\n        }),\n            data = \"\";\n        try {\n            data = await response.json()\n        } catch (error) { }\n        return data\n    }\n    if (document.getElementById(\"ddl\") !== null) {\n        document.getElementById(\"ddl\").onclick = function () {\n            setan(\"drc\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Downloading..\"),\n                or = \"Download File\";\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            generate(\"original\").then(data => {\n                setan(\"drc\");\n                if (data.visit_url) {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.visit_url;\n                } else if (data.url) {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.url;\n                } else {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    if (data.error) {\n                        toastr(\"alert\", data.message)\n                    } else {\n                        toastr(\"alert\", \"Oops, error.\")\n                    }\n                }\n            });\n        };\n    }\n    if (document.getElementById(\"drc\") !== null) {\n        document.getElementById(\"drc\").onclick = function () {\n            setan(\"ddl\", true);\n           