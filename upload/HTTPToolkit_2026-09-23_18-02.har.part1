tentLoaded\",function(){document.querySelectorAll(\".cmz-accordion-header\").forEach(function(h){h.addEventListener(\"click\",function(){var a=this.parentElement,b=a.querySelector(\".cmz-accordion-body\");a.classList.toggle(\"active\");b.style.display=(b.style.display===\"none\"||b.style.display===\"\")?\"block\":\"none\";});});\ndocument.querySelectorAll(\".cmz-filter-box\").forEach(function(box){var seasonSel = box.querySelector(\".cmz-season-filter\");var qualSel = box.querySelector(\".cmz-qual-filter\");var printSel = box.querySelector(\".cmz-print-filter\");\nvar items = box.classList.contains(\"cmz-accordion-filters\") ? document.querySelectorAll(\".cmz-accordion\") : box.querySelectorAll(\".cmz-filter-item\");\nvar seasons = new Set();var quals = new Set();var prints = new Set();\nitems.forEach(function(item) {var s = item.getAttribute(\"data-season\"); if(s) seasons.add(s);var q = item.getAttribute(\"data-quality\"); if(q) quals.add(q);var p = item.getAttribute(\"data-print\"); if(p) prints.add(p);});\nvar sArr = Array.from(seasons).sort(function(a,b){return parseInt(a.replace(/\\D/g,\"\")||0) - parseInt(b.replace(/\\D/g,\"\")||0)});var qArr = Array.from(quals).sort(function(a,b){return parseInt(b)-parseInt(a)});var pArr = Array.from(prints).sort();\nsArr.forEach(function(s){ var opt = document.createElement(\"option\"); opt.value = s; opt.textContent = parseInt(s.replace(/\\D/g, \"\"), 10); seasonSel.appendChild(opt); });qArr.forEach(function(q){ var opt = document.createElement(\"option\"); opt.value = q; opt.textContent = q; qualSel.appendChild(opt); });pArr.forEach(function(p){ if(p===\"Other\")return; var opt = document.createElement(\"option\"); opt.value = p; opt.textContent = p; printSel.appendChild(opt); });if(prints.has(\"Other\")){ var opt = document.createElement(\"option\"); opt.value = \"Other\"; opt.textContent = \"Other\"; printSel.appendChild(opt); }\nif(sArr.length <= 1) seasonSel.parentElement.style.display = \"none\";if(qArr.length <= 1) 