           .navbar-brand {\n                font-size: calc(15px + 0.390625vw);\n            }\n        }\n\n        @media (min-width: 1200px) .h3,\n        h3 {\n            font-size: 1.4rem;\n        }\n\n        /* Sidebar */\n        .sidebar {\n            position: fixed;\n            top: 0;\n            bottom: 0;\n            left: 0;\n            padding: 58px 0 0;\n            /* Height of navbar */\n            box-shadow: 0 2px 5px 0 rgb(0 0 0 / 5%), 0 2px 10px 0 rgb(0 0 0 / 5%);\n            width: 240px;\n            z-index: 600;\n            background-color: #424242;\n        }\n\n        .sidebar .active {\n            border-radius: 5px;\n            box-shadow: 0 2px 5px 0 rgb(0 0 0 / 16%), 0 2px 10px 0 rgb(0 0 0 / 12%);\n        }\n\n        .sidebar-sticky {\n            position: relative;\n            top: 0;\n            height: calc(100vh - 48px);\n            padding-top: 0.5rem;\n            overflow-x: hidden;\n            overflow-y: auto;\n            /* Scrollable contents if viewport is shorter than content. */\n        }\n\n        a:not(.sidenav-link):not(.btn):not(.dropdown-item):not(.nav-link):not(.navbar-brand):not(.page-link):not(.carousel-control-prev):not(.carousel-control-next) {\n            color: #fff;\n        }\n\n        a:not(.sidenav-link):not(.btn):not(.dropdown-item):not(.nav-link):not(.navbar-brand):not(.page-link):not(.carousel-control-prev):not(.carousel-control-next):hover {\n            color: #fff\n        }\n\n        .form-outline .form-control {\n            background: transparent;\n            color: #fff;\n        }\n        \n\n\n    </style>\n    \n    \n    \n\n<style>\n\n/*\n    .card {\n            background-color: #161E42 !important;\n            }\n            \n    body {\n        position: relative;\n        overflow-x: hidden;\n    }\n\n    body::before {\n        content: '';\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background: linear-gradient(45deg, #7fd8be, #a1a7e6, #e1ccec);\n        background-size: 400% 400%;\n        animation: fairyTale 20s ease infinite;\n        z-index: -1;\n    }\n\n    @keyframes fairyTale {\n        0% {\n            background-position: 0% 50%;\n        }\n        50% {\n            background-position: 100% 50%;\n        }\n        100% {\n            background-position: 0% 50%;\n        }\n    }\n    */\n</style>\n\n\n\n\n\n<style>\n    body {\n        background: #0c1136 !important;\n    }\n    \n    /* Override card background */\n    .card {\n        background-color: transparent !important;\n    }\n    \n    /* Override any other MDBootstrap backgrounds */\n    \n    .bg-dark,\n    .sidebar {\n        background-color: #0a0e27 !important;\n    }\n\n    /* Animated background shapes */\n    body::before {\n        content: '';\n        position: fixed;\n        width: 300px;\n        height: 300px;\n        background: radial-gradient(circle, rgba(88, 86, 214, 0.15), transparent);\n        border-radius: 50%;\n        top: -100px;\n        right: -100px;\n        animation: float 20s infinite ease-in-out;\n        z-index: -1;\n    }\n\n    body::after {\n        content: '';\n        position: fixed;\n        width: 250px;\n        height: 250px;\n        background: radial-gradient(circle, rgba(247, 37, 133, 0.15), transparent);\n        border-radius: 50%;\n        bottom: -80px;\n        left: -80px;\n        animation: float 18s infinite ease-in-out reverse;\n        z-index: -1;\n    }\n\n    .bg-shapes {\n        position: fixed;\n        width: 100%;\n        height: 100%;\n        pointer-events: none;\n        z-index: 0;\n        top: 0;\n        left: 0;\n    }\n\n    .shape {\n        position: absolute;\n        opacity: 0.08;\n    }\n\n    .shape-1 {\n        width: 80px;\n        height: 80px;\n        background: linear-gradient(135deg, #5856d6, #f72585);\n        border-radius: 20px;\n        top: 15%;\n        left: 10%;\n        animation: rotate 25s infinite linear;\n    }\n\n    .shape-2 {\n        width: 60px;\n        height: 60px;\n        background: linear-gradient(135deg, #4cc9f0, #7209b7);\n        border-radius: 50%;\n        top: 60%;\n        right: 15%;\n        animation: float 15s infinite ease-in-out;\n    }\n\n    .shape-3 {\n        width: 100px;\n        height: 100px;\n        border: 3px solid #5856d6;\n        border-radius: 50%;\n        bottom: 20%;\n        left: 20%;\n        animation: pulse 10s infinite ease-in-out;\n    }\n\n    .shape-4 {\n        width: 70px;\n        height: 70px;\n        background: linear-gradient(135deg, #f72585, #4cc9f0);\n        border-radius: 15px;\n        top: 30%;\n        right: 25%;\n        animation: rotate 20s infinite linear reverse;\n    }\n\n    .shape-5 {\n        width: 50px;\n        height: 50px;\n        background: linear-gradient(135deg, #7209b7, #f72585);\n        border-radius: 50%;\n        top: 75%;\n        left: 12%;\n        animation: float 18s infinite ease-in-out;\n    }\n\n    .shape-6 {\n        width: 90px;\n        height: 90px;\n        border: 3px solid #4cc9f0;\n        border-radius: 20px;\n        top: 10%;\n        right: 10%;\n        animation: pulse 12s infinite ease-in-out;\n    }\n\n    .shape-7 {\n        width: 65px;\n        height: 65px;\n        background: linear-gradient(135deg, #5856d6, #4cc9f0);\n        border-radius: 50%;\n        bottom: 15%;\n        right: 20%;\n        animation: float 22s infinite ease-in-out reverse;\n    }\n\n    .shape-8 {\n        width: 75px;\n        height: 75px;\n        background: linear-gradient(135deg, #f72585, #7209b7);\n        border-radius: 18px;\n        bottom: 35%;\n        left: 8%;\n        animation: rotate 28s infinite linear;\n    }\n\n    @keyframes float {\n        0%, 100% { transform: translateY(0) translateX(0); }\n        50% { transform: translateY(-30px) translateX(20px); }\n    }\n\n    @keyframes rotate {\n        from { transform: rotate(0deg); }\n        to { transform: rotate(360deg); }\n    }\n\n    @keyframes pulse {\n        0%, 100% { transform: scale(1); opacity: 0.08; }\n        50% { transform: scale(1.1); opacity: 0.12; }\n    }\n</style>\n\n<script type=\"text/javascript\">\n// Disable Auto Scroll\n  Element.prototype.scrollIntoView = function () {};\n</script>\n\n\n\n</head>\n\n<body>\n    \n<div class=\"bg-shapes\">\n    <div class=\"shape shape-1\"></div>\n    <div class=\"shape shape-2\"></div>\n    <div class=\"shape shape-3\"></div>\n    <div class=\"shape shape-4\"></div>\n    <div class=\"shape shape-5\"></div>\n    <div class=\"shape shape-6\"></div>\n    <div class=\"shape shape-7\"></div>\n    <div class=\"shape shape-8\"></div>\n</div>    \n    <header>\n\n  <nav class=\"navbar navbar-expand-lg bg-dark\">\n    <div class=\"container-fluid\">\n\n      <a href=\"https://new4.gdflix.io\" class=\"navbar-brand\">\n        <i class=\"fa fa-bars\"></i> &nbsp; GDFlix\n      </a>\n      <ul class=\"navbar-nav ms-auto d-flex flex-row\">\n         <li class=\"nav-item me-3 me-lg-0\">\n          <a href=\"/login\" class=\"nav-link\">\n            <i class=\"fa fa-sign-in-alt\"></i> Log in </a> <!-- Log in -->\n        </li>       </ul>\n    </div>\n  </nav>\n  <center>\n\n        <!--     -->\n        \n  </center>\n</header>\n<!--\n    <script>\n    window.addEventListener(\"load\", function () {\n        if (document.getElementById(\"cloud\") !== null) {\n            document.getElementById(\"cloud\").disabled = true;\n            setTimeout(function () { document.getElementById(\"cloud\").disabled = false; }, 1500);\n        }\n    });\n    </script>\n-->\n\n<script src=\"https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback\" async defer></script>\n\n\n<div class=\"container pt-4\">\n\n\n    <div class=\"card\" id=\"cf_captcha\">\n\n        <div class=\"card-header text-center py-3\">\n            <h5>\n                <i class=\"far fa-file-alt\"></i>  Deadpool (2016) 2160p 10Bit UHD BluRay REMUX DV HDR x265 HEVC [Hindi - Telugu - Tamil BD DD 5.1 + English TrueHD Atmos 7.1] ESub - CloudMovieZ.Top.mkv  [ 39.4GB ]\n            </h5>\n        </div>\n\n        <!-- <center>\n            \n        \n</center> -->\n\n        <div class=\"card-body\">\n            \n            <div class=\"text-center\">\n                \n                 \n                \n                                \n                                \n                <button type=\"button\" class=\"btn btn-success\" style=\"margin:4px 1px 4px 1px\" id=\"cloud\">\n                <i class=\"fas fa-arrow-down\"></i> Generate Cloud Link </button>\n                <br>\n                \n                <br>\n                \n\n                                \n                                <button type=\"button\" class=\"btn btn-danger\" style=\"margin:4px 1px 4px 1px\" id=\"quick\">\n                    <i class=\"fas fa-bolt\"></i> Generate Quick Link </button>\n                                \n                            </div>\n\n            \n            <br>\n            <!-- <center>\n            \n        \n</center> -->\n            \n            <center>  \n                <small class=\"text-muted\">\n                    <font color=\"grey\"> If <strong> Direct Download</strong> link is not working you can try download\n                        using <strong>Mirrors</strong> if available or you can use <strong>Login to Download</strong>\n                    </font>\n                </small>\n            </center>\n        </div>\n    </div>\n</div>\n<script>\n    var cf_token = \"\";\n    function toastr(title, message) {\n        var toast = document.createElement(\"div\");\n        toast.innerHTML = `<div class=\"toast-header\">\n\t\t\t\t\t<strong class=\"me-auto\">${title}</strong>\n\t\t\t\t\t<button type=\"button\" class=\"btn-close\" data-mdb-dismiss=\"toast\" aria-label=\"Close\"></button>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"toast-body\">${message}</div>`;\n        toast.classList.add(\"toast\", \"fade\");\n        document.body.appendChild(toast);\n        var toastInstance = new mdb.Toast(toast, {\n            stacking: true,\n            hidden: true,\n            width: \"450px\",\n            position: \"top-right\",\n            autohide: true,\n            delay: 3e3\n        });\n        toastInstance.show()\n    }\n    async function generate(action = \"cloud\") {\n        var formData = new FormData;\n        formData.append(\"action\", action);\n        formData.append(\"key\", \"f3f78d1148a2318abe752733fe23d830077750a3\");\n        formData.append(\"action_token\", cf_token);\n        var response = await fetch(window.location.pathname, {\n            method: \"POST\",\n            headers: {\n                'x-token': window.location.hostname,\n            },\n            body: formData\n        }),\n            data = \"\";\n        try {\n            data = await response.json()\n        } catch (error) { }\n        return data\n    }\n    if (document.getElementById(\"cloud\") !== null) {\n        document.getElementById(\"cloud\").onclick = function () {\n            setan(\"cloud\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Generating..\"),\n                or = \"Generating File\";\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            generate(\"cloud\").then(data => {\n                setan(\"cloud\");\n                if (data.visit_url) {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.visit_url;\n                } else if (data.url) {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.url;\n                } else {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    if (data.error) {\n                        toastr(\"alert\", data.message)\n                    } else {\n                        toastr(\"alert\", \"Oops, error.\")\n                    }\n                }\n            });\n        };\n    }\n\n    if (document.getElementById(\"quick\") !== null) {\n        document.getElementById(\"quick\").onclick = function () {\n            setan(\"quick\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Generating..\"),\n                or = '<i class=\"fas fa-bolt\"></i> Generate Quick Link';\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            generate(\"quick\").then(data => {\n                setan(\"quick\");\n                if (data.url) {\n                    // processing, redirect to polling page\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.url;\n                } else if (data.Quick_url) {\n                    // already ready, open directly\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.Quick_url;\n                } else {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    if (data.error) {\n                        toastr(\"alert\", data.message)\n                    } else {\n                        toastr(\"alert\", \"Oops, error.\")\n                    }\n                }\n            });\n        };\n    }\n\n    function setan(