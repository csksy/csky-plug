\");\nvar items = box.classList.contains(\"cmz-accordion-filters\") ? document.querySelectorAll(\".cmz-accordion\") : box.querySelectorAll(\".cmz-filter-item\");\nvar seasons = new Set();var quals = new Set();var prints = new Set();\nitems.forEach(function(item) {var s = item.getAttribute(\"data-season\"); if(s) seasons.add(s);var q = item.getAttribute(\"data-quality\"); if(q) quals.add(q);var p = item.getAttribute(\"data-print\"); if(p) prints.add(p);});\nvar sArr = Array.from(seasons).sort(function(a,b){return parseInt(a.replace(/\\D/g,\"\")||0) - parseInt(b.replace(/\\D/g,\"\")||0)});var qArr = Array.from(quals).sort(function(a,b){return parseInt(b)-parseInt(a)});var pArr = Array.from(prints).sort();\nsArr.forEach(function(s){ var opt = document.createElement(\"option\"); opt.value = s; opt.textContent = parseInt(s.replace(/\\D/g, \"\"), 10); seasonSel.appendChild(opt); });qArr.forEach(function(q){ var opt = document.createElement(\"option\"); opt.value = q; opt.textContent = q; qualSel.appendChild(opt); });pArr.forEach(function(p){ if(p===\"Other\")return; var opt = document.createElement(\"option\"); opt.value = p; opt.textContent = p; printSel.appendChild(opt); });if(prints.has(\"Other\")){ var opt = document.createElement(\"option\"); opt.value = \"Other\"; opt.textContent = \"Other\"; printSel.appendChild(opt); }\nif(sArr.length <= 1) seasonSel.parentElement.style.display = \"none\";if(qArr.length <= 1) qualSel.parentElement.style.display = \"none\";if(pArr.length <= 1) printSel.parentElement.style.display = \"none\";\nif (sArr.length > 0) { seasonSel.value = sArr[sArr.length - 1]; }var blurayPrint = pArr.find(function(p){ return p.toLowerCase().indexOf(\"bluray\") !== -1; });if (blurayPrint) { printSel.value = blurayPrint; }\nfunction doFilter() {var sf = seasonSel.value, qf = qualSel.value, pf = printSel.value;\nvar availableTypes = new Set();items.forEach(function(item) {var s = item.getAttribute(\"data-season\") || \"none\";var q = item.getAttribute(\"data-quality\") || \"none\";var p = item.getAttribute(\"data-print\") || \"none\";var mS = (sf === \"all\" || s === sf);var mQ = (qf === \"all\" || q === qf);var mP = (pf === \"all\" || p === pf);if (mS && mQ && mP) {availableTypes.add(item.getAttribute(\"data-type\") || \"episodes\");}});var tabs = document.querySelectorAll(\".cmz-type-tab\");if (tabs.length > 0) {if (availableTypes.size <= 1) {document.querySelector(\".cmz-type-tabs\").style.display = \"none\";} else {document.querySelector(\".cmz-type-tabs\").style.display = \"flex\";}\ntabs.forEach(function(tab) {var t = tab.getAttribute(\"data-type\");if (!availableTypes.has(t)) {tab.style.display = \"none\";} else {tab.style.display = \"\";}});\nvar activeTab = document.querySelector(\".cmz-type-tab.active\");if (activeTab && !availableTypes.has(activeTab.getAttribute(\"data-type\"))) {activeTab.classList.remove(\"active\");activeTab.style.background = \"#222\";activeTab.style.color = \"#a0a0a0\";activeTab.style.boxShadow = \"none\";\nfor (var i = 0; i < tabs.length; i++) {if (availableTypes.has(tabs[i].getAttribute(\"data-type\"))) {tabs[i].classList.add(\"active\");tabs[i].style.background = \"#0d6efd\";tabs[i].style.color = \"#fff\";tabs[i].style.boxShadow = \"0 2px 5px rgba(0,0,0,0.2)\";break;}}}}var newActiveTab = document.querySelector(\".cmz-type-tab.active\");var tf = newActiveTab ? newActiveTab.getAttribute(\"data-type\") : \"episodes\";\nitems.forEach(function(item) {var s = item.getAttribute(\"data-season\") || \"none\";var q = item.getAttribute(\"data-quality\") || \"none\";var p = item.getAttribute(\"data-print\") || \"none\";var t = item.getAttribute(\"data-type\") || \"episodes\";var mS = (sf === \"all\" || s === sf);var mQ = (qf === \"all\" || q === qf);var mP = (pf === \"all\" || p === pf);var mT = (t === tf);var dType = item.classList.contains(\"cmz-accordion\") ? \"block\" : \"flex\";item.style.display = (mS && mQ && mP && mT) ? dType : \"none\";});}seasonSel.addEventListener(\"change\", doFil