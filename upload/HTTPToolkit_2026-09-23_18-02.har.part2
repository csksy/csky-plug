ding: .2rem;\");\n        div1.innerHTML = message;\n        document.getElementById('fid_' + file).appendChild(div1);\n    }\n\n    function editSuccessURL(file, url) {\n        var div4 = document.createElement('div');\n        div4.setAttribute('class', 'input-group mb-4');\n        var input = document.createElement('input');\n        input.setAttribute('class', 'form-control');\n        input.setAttribute('style', 'text-align: center');\n        input.value = url;\n        input.style.color = \"#818589\";\n        var btn = document.createElement('button');\n        btn.setAttribute('class', 'btn btn-outline-light');\n        btn.setAttribute('type', 'button');\n        btn.innerHTML = '<i class=\"fas fa-copy\"> </i> Copy';\n        btn.onclick = function () {\n            input.select();\n            input.setSelectionRange(0, 99999);\n            document.execCommand(\"copy\");\n        }\n        div4.appendChild(input);\n        div4.appendChild(btn);\n        document.getElementById('fid_' + file).appendChild(div4)\n        document.querySelectorAll('.form-outline').forEach((formOutline) => {\n            new mdb.Input(formOutline).init();\n        });\n    }\n\n    async function generate(file, action = \"original\") {\n        var formData = new FormData;\n        formData.append(\"action\", action);\n        formData.append(\"key\", \"c5eff6b83547bdf373405347374b4c5248484c98\");\n        formData.append(\"action_token\", cf_token);\n        formData.append('file', file);\n        var response = await fetch(window.location.pathname, {\n            method: \"POST\",\n            headers: {\n                'x-token': window.location.hostname,\n            },\n            body: formData\n        }),\n            data = \"\";\n        try {\n            data = await response.json()\n        } catch (error) { }\n\n        if (data.visit_url) {\n            window.location.href = data.visit_url;\n        } else {\n            return data;\n        }\n\n    }\n\n    async function copyfiles(index, action = \"original\") {\n\n        if (index >= fkeys.length) {\n            var bute = document.getElementById(\"original\");\n            var dirt = document.getElementById(\"direct\");\n            if (bute !== null) {\n                bute.disabled = true;\n                bute.innerHTML = \"All Files Copied\";\n            }\n            if (dirt !== null) {\n                dirt.disabled = true;\n                dirt.innerHTML = \"All Files Copied\";\n            }\n            cloningStatus(\"All Files Cloned!\");\n\n        } else {\n\n            cloningStatus(\"Cloning File : \" + fkeys[index]);\n\n            await new Promise(resolve => setTimeout(resolve, 100));\n\n            generate(fkeys[index], action).then(data => {\n\n                if (data.url) {\n\n                    editSuccessURL(fkeys[index], data.url);\n\n                } else {\n\n                    if (data.error) {\n                        editElemMessage(fkeys[index], data.message);\n                    } else {\n                        editElemMessage(fkeys[index], \"Cannot Copy This File\");\n                    }\n                }\n\n                copyfiles(index + 1, action);\n\n            }).catch(error => {\n\n                editElemMessage(fkeys[index], \"Cannot Copy This File\");\n\n                copyfiles(index + 1, action);\n\n            })\n\n        }\n    }\n\n    if (document.getElementById(\"original\") !== null) {\n        document.getElementById(\"original\").onclick = function () {\n            setan(\"direct\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Cloning all Files..\"),\n                or = \"Cloning Files\";\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            if (fkeys.length >= 1) {\n                copyfiles(0);\n            }\n        };\n    }\n\n    if (document.getElementById(\"direct\") !== null) {\n        document.getElementById(\"direct\").onclick = function () {\n            setan(\"original\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Cloning all Files..\"),\n                or = \"Cloning Files\";\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            if (fkeys.length >= 1) {\n                copyfiles(0, \"direct\");\n            }\n        };\n    }\n\n    function setan(action, hide = false) {\n        if (document.getElementById(action) !== null) {\n            var actn = document.getElementById(action);\n            if (!hide) {\n                actn.disabled = false;\n            } else {\n                actn.disabled = true;\n            }\n        }\n    }\n</script>\n<br>\n<center>\n    <div id=\"pages\" style=\"width:90%;\">\n        <center>\n    <div class=\"card\" style=\"width:90%;\">\n        <div class=\"card-header\" style=\"border:0px;\">\n            <h6 class=\"mb-0 text-center\">\n\n                <strong>\n\n                    <a href=\"https://new4.gdflix.io/about-us\">\n                        <i class=\"fa fa-info-circle text-light\"></i> About US\n                    </a> |\n                    <a href=\"https://new4.gdflix.io/page/privacy-policy\">\n                        <i class=\"fa fa-bullhorn text-light\"></i> Privacy & Policy\n                    </a> |\n                    <a href=\"https://new4.gdflix.io/page/terms-conditions\">\n                        <i class=\"fa fa-book text-light\"></i> Terms & Conditions\n                    </a> |\n                    <a href=\"https://new4.gdflix.io/copyright-policy\