  data = \"\";\n        try {\n            data = await response.json()\n        } catch (error) { }\n        return data\n    }\n    if (document.getElementById(\"cloud\") !== null) {\n        document.getElementById(\"cloud\").onclick = function () {\n            setan(\"cloud\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Generating..\"),\n                or = \"Generating File\";\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            generate(\"cloud\").then(data => {\n                setan(\"cloud\");\n                if (data.visit_url) {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.visit_url;\n                } else if (data.url) {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.url;\n                } else {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    if (data.error) {\n                        toastr(\"alert\", data.message)\n                    } else {\n                        toastr(\"alert\", \"Oops, error.\")\n                    }\n                }\n            });\n        };\n    }\n\n    if (document.getElementById(\"quick\") !== null) {\n        document.getElementById(\"quick\").onclick = function () {\n            setan(\"quick\", true);\n            this.disabled = true;\n            this.innerHTML = \"\";\n            var span = document.createElement(\"span\"),\n                text = document.createTextNode(\" Generating..\"),\n                or = '<i class=\"fas fa-bolt\"></i> Generate Quick Link';\n            span.setAttribute(\"class\", \"spinner-border spinner-border-sm\");\n            this.appendChild(span);\n            this.appendChild(text);\n            generate(\"quick\").then(data => {\n                setan(\"quick\");\n                if (data.url) {\n                    // processing, redirect to polling page\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.url;\n                } else if (data.Quick_url) {\n                    // already ready, open directly\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    window.location.href = data.Quick_url;\n                } else {\n                    this.innerHTML = or;\n                    this.disabled = false;\n                    if (data.error) {\n                        toastr(\"alert\", data.message)\n                    } else {\n                        toastr(\"alert\", \"Oops, error.\")\n                    }\n                }\n            });\n        };\n    }\n\n    function setan(action, hide = false) {\n        if (document.getElementById(action) !== null) {\n            var actn = document.getElementById(action);\n            if (!hide) {\n                actn.disabled = false;\n            } else {\n                actn.disabled = true;\n            }\n        }\n    }\n\n</script>\n\n<br>\n<center>\n    <div id=\"pages\" style=\"width:90%;\"> <center>\n    <div class=\"card\" style=\"width:90%;\">\n        <div class=\"card-header\" style=\"border:0px;\">\n            <h6 class=\"mb-0 text-center\">\n\n                <strong>\n\n                    <a href=\"https://new4.gdflix.io/about-us\">\n                        <i class=\"fa fa-info-circle text-light\"></i> About US\n                    </a> |\n                    <a href=\"https://new4.gdflix.io/page/privacy-policy\">\n                        <i class=\"fa fa-bullhorn text-light\"></i> Privacy & Policy\n                    </a> |\n        