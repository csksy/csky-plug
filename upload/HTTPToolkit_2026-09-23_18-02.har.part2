},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"name":"Permissions-Policy","value":"geolocation=(self), microphone=(self), camera=(self)"},{"name":"cf-cache-status","value":"DYNAMIC"},{"name":"Server-Timing","value":"cfCacheStatus;desc=\"DYNAMIC\""},{"name":"Server-Timing","value":"cfEdge;dur=7,cfOrigin;dur=893"},{"name":"content-encoding","value":"zstd"},{"name":"CF-RAY","value":"a3f98e79aebde1c0-MRS"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"}],"content":{"mimeType":"text/html; charset=UTF-8","size":7186,"text":"<!DOCTYPE html><html lang=\"en-US\"><head> <meta charset=\"UTF-8\" /> <meta name=\"robots\" content=\"noindex, follow\"> <meta name=\"viewport\" content=\"width=device-width, user-scalable=no, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0\"> <title> - Download</title> <link rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' type='text/css' media='all' /> <style> *{box-sizing:border-box;margin:0;padding:0;font-family:'Inter',sans-serif}body{background-color:#12141a;/* Dark background */ display:flex;justify-content:center;align-items:center;min-height:100vh;color:#fff}.container{width:100%;max-width:480px;padding:20px}.download-card{background-color:#1d1e24;border-radius:16px;padding:30px 25px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.05)}.title{color:#b47dff;font-size:22px;font-weight:600;margin-bottom:5px}.subtitle{color:#9aa0a6;font-size:13px;margin-bottom:30px}/* Circular Timer */ .timer-wrapper{position:relative;width:140px;height:140px;margin:0 auto 15px auto}.timer-svg{transform:rotate(-90deg);width:140px;height:140px}.timer-circle-bg{fill:none;stroke:#2a2c35;stroke-width:8}.timer-circle-progress{fill:none;stroke:url(#gradient);stroke-width:8;stroke-linecap:round;stroke-dasharray:377;/* 2 * PI * r (r=60) */ stroke-dashoffset:0;transition:stroke-dashoffset 1s linear}.timer-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:42px;font-weight:700;color:#fff}.wait-text{color:#888;font-size:13px;margin-bottom:30px}/* Instructions Box */ .instructions-box{background-color:#262831;border-radius:12px;padding:20px;text-align:left;margin-bottom:20px}.instructions-title{font-size:14px;font-weight:600;margin-bottom:15px;display:flex;align-items:center;gap:8px}.instruction-step{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;font-size:12px;color:#b0b4ba;line-height:1.5}.instruction-step:last-child{margin-bottom:0}.step-number{background-color:#6139b4;color:#fff;width:20px;height:20px;border-radius:50%;display:flex;justify-content:center;align-items:center;font-size:11px;font-weight:700;flex-shrink:0;margin-top:2px}/* Success State Elements (Hidden initially) */ .success-badge{display:none;background-color:#00b862;color:#fff;font-size:12px;font-weight:600;padding:8px 20px;border-radius:20px;display:inline-block;margin-bottom:15px}.ready-text{display:none;color:#00b862;font-size:14px;font-weight:500;margin-bottom:20px;display:flex;align-items:center;justify-content:center;gap:5px}.continue-btn{display:none;background:linear-gradient(135deg,#8a4bfa 0%,#6526d1 100%);color:#fff;text-decoration:none;padding:14px 40px;border-radius:8px;font-size:15px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 4px 15px rgba(138,75,250,0.4);transition:transform 0.2s ease,box-shadow 0.2s ease;margin-bottom:30px}.continue-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(138,75,250,0.6)}/* Movie Title Footer */ .footer-title{color:#666;font-size:13px;margin-top:10px}/* Utility classes to toggle visibility via JS */ .hide{display:none !important}.show-inline{display:inline-block !important}.show-flex{display:flex !important}</style></head><body> <div class=\"container\"> <div class=\"download-card\"> <div class=\"title\">Download Ready</div> <div class=\"subtitle\">Please wait while we prepare your download link</div> <!-- TIMER SECTION --> <div id=\"timer-section\"> <div class=\"timer-wrapper\"> <svg class=\"timer-svg\" viewBox=\"0 0 140 140\"> <defs> <linearGradient id=\"gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"> <stop offset=\"0%\" stop-color=\"#b47dff\" /> <stop offset=\"100%\" stop-color=\"#4e88ff\" /> </linearGradient> </defs> <circle class=\"timer-circle-bg\" cx=\"70\" cy=\"70\" r=\"60\"></circle> <circle class=\"timer-circle-progress\" id=\"progress-circle\" cx=\"70\" cy=\"70\" r=\"60\"></circle> </svg> <div class=\"timer-text\" id=\"countdown-number\">3</div> </div> <div class=\"wait-text\">Please wait <span style=\"letter-spacing:2px;color:#b47dff;\">...</span></div> </div> <!-- SUCCESS SECTION (Hidden initially) --> <div id=\"success-section\" class=\"hide\"> <div class=\"success-badge\">✔ LINK GENERATED SUCCESSFULLY</div> <div class=\"ready-text\">⚡ Ready to Download</div> <a id=\"link\" rel=\"nofollow\" href=\"https://gdflix.dev/pack/knUeUp96SE\" class=\"continue-btn\"> <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><polyline points=\"19 12 12 19 5 12\"></polyline></svg> Continue </a> </div> <!-- INSTRUCTIONS SECTION --> <div class=\"instructions-box\"> <div class=\"instructions-title\"> <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#b47dff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line><polyline points=\"10 9 9 9 8 9\"></polyline></svg> Download Instructions </div> <div class=\"instruction-step\"> <div class=\"step-number\">1</div> <div>Download Now Click If you move to another site after doing so, you must exit that site.</div> </div> <div class=\"instruction-step\"> <div class=\"step-number\">2</div> <div>Close [ x ] that web page or go Back 🔙 and return to this page.</div> </div> <div class=\"instruction-step\"> <div class=\"step-number\">3</div> <div>Then click Download Now and the download will begin ✅</div> </div> </div> <div class=\"footer-title\"></div> </div> </div> <script type=\"text/javascript\">document.addEventListener(\"DOMContentLoaded\", function() {var totalTime = 3;var timeLeft = totalTime;\nvar numberDisplay = document.getElementById(\"countdown-number\");var circle = document.getElementById(\"progress-circle\");var timerSection = document.getElementById(\"timer-section\");var successSection = document.getElementById(\"success-section\");\n// Total circumference of circle (r=60 -> 2*PI*60 = 377)\nvar circumference = 377;\nif (totalTime <= 0) {finishCountdown();return;}\nvar interval = setInterval(function() {timeLeft--;numberDisplay.innerText = timeLeft;\n// Calculate dash offset for circle progress\nvar progress = timeLeft / totalTime;var offset = circumference * (1 - progress);circle.style.strokeDashoffset = offset;\nif (timeLeft <= 0) {clearInterval(interval);finishCountdown();}}, 1000);\nfunction finishCountdown() {timerSection.classList.add(\"hide\");successSection.classList.remove(\"hide\");successSection.style.display = \"block\";}});</script><script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495\" integrity=\"sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"348a1e35edf84b2eab8a80d3033d37e9\",\"r\":1,\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body></html>\n<!-- Cached by WP-Optimize (gzip) - https://teamupdraft.com/wp-optimize/ - Last modified: September 23, 2026 12:29 pm (UTC:0) -->