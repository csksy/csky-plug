ng{background-color:rgba(0,137,123,0.15);color:#4db6ac;border-color:rgba(0,137,123,0.3)}.cmz-tag-quality{background-color:rgba(46,125,50,0.15);color:#81c784;border-color:rgba(46,125,50,0.3)}.cmz-accordion-icon{margin-left:15px;width:7px;height:7px;border-right:2px solid #888;border-bottom:2px solid #888;transform:rotate(45deg);transition:all .3s ease;margin-right:5px}.cmz-accordion-header:hover .cmz-accordion-icon{border-color:#e53935}.cmz-accordion.active .cmz-accordion-icon{transform:rotate(225deg);border-color:#ff5252;margin-top:5px}.cmz-accordion-body{background-color:transparent;padding:15px 5px}/* Filter Box Styles */ .cmz-filter-box{background:#111;border-radius:8px;border:1px solid #222;font-family:Arial,sans-serif;margin-bottom:20px;box-shadow:0 10px 20px rgba(0,0,0,0.3)}.cmz-filter-header{background:#181818;padding:15px 20px;border-radius:8px 8px 0 0;display:flex;gap:15px;border-bottom:1px solid #2c2c2c;flex-wrap:wrap;justify-content:center}.cmz-filter-select-wrap{display:flex;align-items:center}.cmz-filter-label{color:#a0a0a0;font-size:13px;margin-right:8px;font-weight:600;display:flex;align-items:center}.cmz-filter-select{background:#0d6efd;color:#fff;border:none;border-radius:4px;padding:6px 12px;font-size:13px;outline:none;cursor:pointer;font-weight:600;appearance:auto;min-width:120px;box-shadow:0 2px 5px rgba(13,110,253,0.3)}.cmz-filter-select option{background:#222;color:#fff}.cmz-filter-body{padding:15px;display:flex;flex-direction:column;gap:10px}/* Custom Select UI (Tamiltvtoons style) */ .cmz-custom-select{position:relative;user-select:none;width:100%;font-family:Arial,sans-serif}.cmz-select-trigger{background-color:#1a1d24;border:1px solid #2a2d34;border-radius:20px;padding:10px 16px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;color:#a0a0a0;font-size:13px;transition:all 0.2s ease;box-shadow:0 2px 5px rgba(0,0,0,0.2)}.cmz-select-trigger:hover{background-color:#20232a;border-color:#3a3d44}.cmz-select-label{white-space:nowrap;display:flex;align-items:center}.cmz-select-label strong{color:#fff;margin-left:6px;font-weight:600;white-space:nowrap}.cmz-arrow{width:14px;height:14px;fill:#a0a0a0;margin-left:10px;transition:transform 0.2s ease;flex-shrink:0}.cmz-custom-select.open .cmz-arrow{transform:rotate(180deg)}.cmz-select-options{position:absolute;top:calc(100% + 8px);left:0;min-width:150px;background-color:#1a1d24;border:1px solid #2a2d34;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,0.5);opacity:0;visibility:hidden;transform:translateY(-10px);transition:all 0.2s ease;z-index:1000;max-height:250px;overflow-y:auto;padding:6px 0}.cmz-custom-select.open .cmz-select-options{opacity:1;visibility:visible;transform:translateY(0)}.cmz-option{padding:10px 20px;color:#e0e0e0;font-size:14px;cursor:pointer;transition:background-color 0.2s ease}.cmz-option:hover{background-color:#2a2d34}.cmz-option.selected{background-color:#0d6efd;color:#fff;font-weight:600}/* Button Row Styles */ .cmz-button-grid{display:flex;flex-direction:column;gap:12px}.cmz-button-grid br,.cmz-button-grid p,.cmz-filter-body br,.cmz-filter-body p{display:none !important;margin:0 !important;padding:0 !important}.cmz-row-card{background-color:rgba(255,255,255,0.03);border-radius:6px;display:flex;flex-direction:row;justify-content:space-between;align-items:center;padding:12px 15px;width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,0.05);transition:background-color .2s ease}.cmz-row-card:hover{background-color:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.1)}.cmz-row-content{display:flex;flex-direction:column}.cmz-row-title{font-size:14px;text-align:left;margin-bottom:0;line-height:1.4;word-break:break-word;color:#e0e0e0;font-weight:500}.cmz-btn-group{display:flex;gap:8px;flex-wrap:nowrap}.cmz-download-btn{border-radius:4px;text-decoration:none;display:flex;align-items:center;justify-content:center;padding:10px 18px;transition:background-color .3s ease,transform .2s ease;font-size:14px;font-